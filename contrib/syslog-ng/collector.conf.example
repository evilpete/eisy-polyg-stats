#############################################################################
# collector.conf.example -- the other end
#
# Example configuration for the remote log server that receives what the
# eisy forwards.  Messages arrive as RFC5424 with the original timestamp,
# so the files below are written in the order the events happened on the
# eisy, not the order they were received.
#############################################################################

@version: 4.2
@include "scl.conf"

source s_eisy {
    syslog(
        ip(0.0.0.0)
        port(601)
        transport("tcp")
        # 256 KiB: the PG3 plugin-store records are single very long lines.
        log-msg-size(262144)
        keep-timestamp(yes)
        keep-hostname(yes)
        flags(no-multi-line)
    );
};

filter f_eisy { host("eisy" type(string)); };

# One file per log source, split by the facility the eisy assigned.
destination d_eisy_files {
    file("/var/log/eisy/${HOST}/${PROGRAM}-${YEAR}${MONTH}${DAY}.log"
        template("${ISODATE} ${HOST} ${PROGRAM}[${PID}] ${LEVEL} ${MSGHDR}${MESSAGE}\n")
        create-dirs(yes)
        dir-perm(0750)
        perm(0640)
    );
};

log {
    source(s_eisy);
    filter(f_eisy);
    destination(d_eisy_files);
};
